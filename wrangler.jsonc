{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friend-game-hall-backend",
  "main": "worker/room-worker.js",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
